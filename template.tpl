___SANDBOXED_JS_FOR_WEB_TEMPLATE___

// Privacyboard cookie banner for Google Tag Manager.
// 1. Google Consent Mode v2: every signal denied (security storage granted) until the visitor chooses.
// 2. The banner script, which applies the saved choice or asks, and sends the update (gtag 'consent' 'update').
const setDefaultConsentState = require('setDefaultConsentState');
const gtagSet = require('gtagSet');
const injectScript = require('injectScript');
const encodeUriComponent = require('encodeUriComponent');
const makeNumber = require('makeNumber');
const log = require('logToConsole');

const id = data.bannerId;
const wait = makeNumber(data.waitForUpdate);

setDefaultConsentState({
  ad_storage: 'denied',
  ad_user_data: 'denied',
  ad_personalization: 'denied',
  analytics_storage: 'denied',
  functionality_storage: 'denied',
  personalization_storage: 'denied',
  security_storage: 'granted',
  wait_for_update: wait >= 0 ? wait : 500
});
gtagSet('ads_data_redaction', data.adsDataRedaction === true);
gtagSet('url_passthrough', data.urlPassthrough === true);

injectScript('https://privacyboard.io/cmp/' + encodeUriComponent(id) + '.js', data.gtmOnSuccess, function () {
  log('Privacyboard: the banner script could not be loaded. Tracking stays denied.');
  data.gtmOnFailure();
}, 'privacyboard-cmp');



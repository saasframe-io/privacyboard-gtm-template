___TESTS___

scenarios:
- name: Sets the default consent state and loads the banner
  code: |-
    const mockData = { bannerId: 'abcdef0123456789', waitForUpdate: '500', adsDataRedaction: true, urlPassthrough: false };
    let injected;
    mock('injectScript', (url, onSuccess) => { injected = url; onSuccess(); });
    runCode(mockData);
    assertApi('setDefaultConsentState').wasCalledWith({
      ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', analytics_storage: 'denied',
      functionality_storage: 'denied', personalization_storage: 'denied', security_storage: 'granted', wait_for_update: 500
    });
    assertApi('gtagSet').wasCalledWith('ads_data_redaction', true);
    assertThat(injected).isEqualTo('https://privacyboard.io/cmp/abcdef0123456789.js');
    assertApi('gtmOnSuccess').wasCalled();
- name: Fails when the script cannot load
  code: |-
    mock('injectScript', (url, onSuccess, onFailure) => { onFailure(); });
    runCode({ bannerId: 'abcdef0123456789', waitForUpdate: '500' });
    assertApi('gtmOnFailure').wasCalled();


